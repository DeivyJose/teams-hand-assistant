{
  "manifest_version": 3,
  "name": "Teams Hand Assistant",
  "version": "0.0.1",
  "description": "Extensión para Microsoft Teams Web que ayuda a controlar la posición del usuario en la cola de manos levantadas.",
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}